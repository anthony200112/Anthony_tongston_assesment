# ── MongoDB Atlas ──────────────────────────────────────────────
# Replace user:pass and cluster host with your Atlas credentials.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/tongston_t_world?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────────────────────
# Any long random string. Used to sign JWTs.
JWT_SECRET=replace-with-a-secure-random-string

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ───────────────────────────────────────────────────────
# The frontend origin that is allowed to call the API.
FRONTEND_URL=http://localhost:5173

# ── Admin seed (optional) ──────────────────────────────────────
# A default admin account is created on first boot with these credentials.
ADMIN_EMAIL=admin@tongston.com
ADMIN_PASSWORD=Admin123!
